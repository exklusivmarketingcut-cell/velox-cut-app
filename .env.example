# In Vercel unter Project → Settings → Environment Variables eintragen (NICHT in Git einchecken).
# Supabase (Project Settings → API) – bei Verbindung über den Vercel-Marketplace werden diese automatisch gesetzt
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys). Zum Testen die sk_test_/pk_test_-Schlüssel.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# E-Mails (resend.com, Domain velox-cut.de verifizieren)
RESEND_API_KEY=
EMAIL_FROM=Velox Cut <noreply@velox-cut.de>
OWNER_EMAIL=infoveloxcut@gmail.com
