# Schnitt-Maschine (läuft auf deinem Mac). Wird mit scripts/-Hilfen befüllt – Schlüssel nie in den Chat kopieren.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKER_NAME=mac-nunu
# Video-Speicher Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=veloxcut-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Für Schritt 2 (KI-Momentsuche):
GEMINI_API_KEY=
# Claude-Schnitt: CLAUDE_SCHNITT=lern|alle. Die Maschine startet pro abgelegtem Auftrag selbst einen Claude-Lauf (kein Zeitplan mehr).
# Anmeldung für die Läufe (eins von beiden): Schlüssel aus `claude setup-token` bzw. API-Schlüssel von console.anthropic.com
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# Optional: CLAUDE_AUTOSTART=0 (aus, wieder über die geplante Aufgabe), CLAUDE_PARALLEL=1, CLAUDE_BIN=/pfad/zu/claude, CLAUDE_LAUF_MAX_MIN=85
